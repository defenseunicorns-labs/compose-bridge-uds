{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI package tags in documentation and workflows",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^\\.github/workflows/awesome-compose\\.yml$/"
      ],
      "matchStrings": [
        "uds zarf package deploy oci://(?<depName>ghcr\\.io/[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update pinned compatibility tool versions",
      "managerFilePatterns": ["/^\\.github/workflows/awesome-compose\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\\s]+)\\s+[A-Z0-9_]+_VERSION: (?<currentValue>v?[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}

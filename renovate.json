{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^internal/render/templates/tasks\\.yaml$"],
      "matchStrings": [
        "uds-common/(?<currentValue>v[\\d.]+)/tasks/"
      ],
      "depNameTemplate": "defenseunicorns/uds-common",
      "datasourceTemplate": "github-tags",
      "versioning": "semver"
    }
  ]
}

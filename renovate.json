{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^internal/render/templates/tasks\\.yaml$"],
      "matchStrings": [
        "uds-common/(?<currentValue>v[\\d.]+)/tasks/"
      ],
      "depNameTemplate": "defenseunicorns/uds-common",
      "datasourceTemplate": "github-tags",
      "versioning": "semver"
    }
  ]
}
